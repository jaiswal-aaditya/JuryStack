# Safe local-only defaults used by Docker Compose.
POSTGRES_DB=jurystack
POSTGRES_USER=jurystack
POSTGRES_PASSWORD=jurystack

# Backend settings use the JURYSTACK_ prefix. The Compose default points at the
# local db service; override only for local development outside Compose.
JURYSTACK_DATABASE_URL=postgresql+asyncpg://jurystack:jurystack@db:5432/jurystack
JURYSTACK_FIXTURES_PATH=/app/fixtures.json
JURYSTACK_SESSION_COOKIE_NAME=session
JURYSTACK_SESSION_COOKIE_SECURE=false
JURYSTACK_SESSION_TTL_SECONDS=43200
